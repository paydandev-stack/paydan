@@ -0,0 +1,30 @@
+import { fireEvent, render } from "@testing-library/react-native";
+import React from "react";
+import { BrandHeader, BrandHero, SectionHeading } from "../components/brand";
+
+describe("PAYDAN storefront brand components", () => {
+  it("renders the wordmark and a tappable header action", async () => {
+    const onAction = jest.fn();
+    const view = await render(<BrandHeader actionLabel="Account" onAction={onAction} />);
+
+    expect(view.getByText("PAYDAN")).toBeTruthy();
+    expect(view.getByText("EVERYDAY, SOURCED WITH CARE")).toBeTruthy();
+    await fireEvent.press(view.getByTestId("brand-header-action"));
+    expect(onAction).toHaveBeenCalledTimes(1);
+  });
+
+  it("uses the web hero copy and section kicker vocabulary", async () => {
+    const onExplore = jest.fn();
+    const hero = await render(<BrandHero onPress={onExplore} />);
+    expect(hero.getByText("THE PAYDAN EDIT")).toBeTruthy();
+    expect(hero.getByText("Everything you need, sourced with care.")).toBeTruthy();
+    await fireEvent.press(hero.getByTestId("hero-explore"));
+    expect(onExplore).toHaveBeenCalledTimes(1);
+
+    const section = await render(
+      <SectionHeading kicker="CURATED FOR YOU" title="Trending now" />,
+    );
+    expect(section.getByText("CURATED FOR YOU")).toBeTruthy();
+    expect(section.getByText("Trending now")).toBeTruthy();
+  });
+});
