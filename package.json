{
  "name": "paydan-next",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed-catalog.ts",
    "db:bootstrap:departments": "node --conditions=react-server --import tsx scripts/bootstrap-departments.ts",
    "db:seed:local-state": "tsx scripts/seed-local-state.ts",
    "db:seed:users": "tsx scripts/seed-dev-user.ts",
    "db:bootstrap:local": "tsx scripts/bootstrap-local.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "worker:mail": "node --conditions=react-server --import tsx scripts/mail-worker.ts",
    "worker:payments": "tsx scripts/reconcile-payments.ts",
    "config:check": "tsx scripts/check-config.ts",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.138",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/cloudfront-signer": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "ai": "^7.0.165",
    "better-auth": "^1.7.17",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "svix": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
