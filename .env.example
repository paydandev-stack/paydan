# Neon PostgreSQL. Keep live credentials in Vercel/project secrets or a
# gitignored .env.local file; never commit connection strings or passwords.
# The pooled URL is used by the application. Use the direct URL for migrations
# and administrative operations when the provider requires an unpooled session.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
# Compatibility variables supplied by the Neon/Vercel integration.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
# Must match the origin used by your browser and Google OAuth configuration.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact additional origins, for example:
# https://paydan.store,https://www.paydan.store
BETTER_AUTH_TRUSTED_ORIGINS=
TEST_BUYER_EMAIL=buyer@paydan.local
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use sk_test_ first. Never expose this as NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=

# Explicit native deep-link prefixes allowed for Paystack mobile return URLs.
# Better Auth separately trusts exp:// for Expo Go and paydan:// for native
# builds. Never disable origin checking globally.
MOBILE_APP_SCHEMES=paydan://app,https://paydan.store
# Server-only Expo Push access token used by the push outbox worker.
# Never expose this as NEXT_PUBLIC_* or EXPO_PUBLIC_*.
EXPO_ACCESS_TOKEN=
# Private AWS S3 bucket. Prefer an IAM role in production; AWS SDK uses its default credential chain.
# For local Docker/MinIO, set S3_ENDPOINT/S3_PUBLIC_ENDPOINT and S3_FORCE_PATH_STYLE=true.
AWS_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public HTTPS base URL for immutable catalog objects served by CloudFront,
# for example https://media.example.com. The S3 bucket itself remains private.
MEDIA_CDN_URL=
# CloudFront signed delivery for private sourcing/return media. Store the
# private key as a base64-encoded PEM secret; never commit the PEM file.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_BASE64=
CLOUDFRONT_SIGNED_URL_TTL_SECONDS=300
# Transactional mail; run the durable mail worker every minute.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Use these after updates.paydan.store is verified in Resend. MAIL_FROM remains
# a backwards-compatible fallback for local development.
MAIL_FROM_AUTH=PAYDAN Accounts <accounts@updates.paydan.store>
MAIL_FROM_ORDERS=PAYDAN Orders <orders@updates.paydan.store>
MAIL_FROM_SUPPORT=PAYDAN Support <support@updates.paydan.store>
MAIL_REPLY_TO=
OPERATIONS_NOTIFICATION_EMAIL=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
SITE_INDEXING_ENABLED=false
# Set only after the client approves the matching policy copy.
POLICIES_APPROVED_VERSION=
# Set these ISO timestamps only after the named staging acceptance test passes.
GOOGLE_OAUTH_ACCEPTED_AT=
STORAGE_ACCEPTED_AT=
PAYSTACK_ACCEPTED_AT=
EMAIL_ACCEPTED_AT=
AI_ACCEPTED_AT=
# AI routing: direct Groq, then OpenRouter Free, then the deterministic
# assistant. Keep all keys server-only and rotate any key exposed in chat/logs.
AI_PROVIDER_PROFILE=production
AI_PROVIDER_TIMEOUT_MS=12000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://paydan.store
OPENROUTER_APP_NAME=PAYDAN
ASSISTANT_RATE_LIMIT_GUEST=12
ASSISTANT_RATE_LIMIT_USER=30
# Explicitly enable only for an empty TEST database. No customer/order fixtures are seeded.
ALLOW_SAMPLE_CATALOG=false
