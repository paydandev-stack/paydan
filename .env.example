# PostgreSQL connection. Use verified TLS settings supplied by your host.
DATABASE_URL=
# Must match the origin used by your browser and Google OAuth configuration.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use sk_test_ first. Never expose this as NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
# Private AWS S3 bucket. Prefer an IAM role in production; AWS SDK uses its default credential chain.
# For local Docker/MinIO, set S3_ENDPOINT/S3_PUBLIC_ENDPOINT and S3_FORCE_PATH_STYLE=true.
AWS_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Transactional mail; run the durable mail worker every minute.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional until an AI provider is selected. Must support chat-completions JSON responses.
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
# Explicitly enable only for an empty TEST database. No customer/order fixtures are seeded.
ALLOW_SAMPLE_CATALOG=false
