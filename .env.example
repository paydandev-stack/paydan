# Neon PostgreSQL. Keep live credentials in Vercel/project secrets or a
# gitignored .env.local file; never commit connection strings or passwords.
# The pooled URL is used by the application. Use the direct URL for migrations
# and administrative operations when the provider requires an unpooled session.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
# Compatibility variables supplied by the Neon/Vercel integration.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
# Must match the origin used by your browser and Google OAuth configuration.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact additional origins, for example:
# https://paydan.store,https://www.paydan.store
BETTER_AUTH_TRUSTED_ORIGINS=
TEST_BUYER_EMAIL=buyer@paydan.local
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use sk_test_ first. Never expose this as NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
# Private AWS S3 bucket. Prefer an IAM role in production; AWS SDK uses its default credential chain.
# For local Docker/MinIO, set S3_ENDPOINT/S3_PUBLIC_ENDPOINT and S3_FORCE_PATH_STYLE=true.
AWS_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public HTTPS base URL for immutable catalog objects served by CloudFront,
# for example https://media.example.com. The S3 bucket itself remains private.
MEDIA_CDN_URL=
# CloudFront signed delivery for private sourcing/return media. Store the
# private key as a base64-encoded PEM secret; never commit the PEM file.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_BASE64=
CLOUDFRONT_SIGNED_URL_TTL_SECONDS=300
# Transactional mail; run the durable mail worker every minute.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
OPERATIONS_NOTIFICATION_EMAIL=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
# AI routing. Production uses Vercel AI Gateway with a primary and secondary
# model. Direct Groq access is restricted to non-production test profiles.
AI_PROVIDER_PROFILE=production
AI_GATEWAY_API_KEY=
AI_PRIMARY_MODEL=anthropic/claude-haiku-5.5
AI_SECONDARY_MODEL=openai/gpt-6-luna
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ASSISTANT_RATE_LIMIT_GUEST=12
ASSISTANT_RATE_LIMIT_USER=30
# Explicitly enable only for an empty TEST database. No customer/order fixtures are seeded.
ALLOW_SAMPLE_CATALOG=false
